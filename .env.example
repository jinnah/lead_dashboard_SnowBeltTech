# SnowBeltTech Lead Portal - local development configuration template.
# Copy to .env.local (ignored by git) or run: pnpm run env:local
# PLACEHOLDERS ONLY. Never commit real values.

# Browser-safe (public) values. The anon/publishable key is NOT a secret but must never be
# confused with the service-role key. Only values prefixed NEXT_PUBLIC_ reach the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-or-publishable-key

# Server-only. NEVER prefix these with NEXT_PUBLIC_. Consumed only by src/lib/server/* (server-only modules).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Bearer token n8n presents to POST /api/internal/ingest (>= 32 random bytes; 64 hex chars).
N8N_INGEST_TOKEN=replace-with-64-hex-characters-generated-by-pnpm-run-env-local
